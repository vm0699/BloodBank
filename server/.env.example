# Copy to .env (server/.env is git-ignored). See docs/BACKEND.md for every variable.

PORT=8787
# Public https URL of this server. DigiLocker redirects here, so it must match the redirect URI registered with DigiLocker:
#   <PUBLIC_BASE_URL>/api/digilocker/callback
PUBLIC_BASE_URL=https://api.example.com
DATA_DIR=./data
# production turns on safety checks (refuses DEV_OTP, warns without JWT_SECRET)
# NODE_ENV=production
# JWT_SECRET=a-long-random-string
# Contact shown on the privacy policy and terms pages
# SUPPORT_EMAIL=support@example.com

# --- Database: MongoDB. Empty = a JSON file in DATA_DIR (development only) ---
# Local LifeLink-only server (npm run db, then npm run db:setup writes this line for you):
# MONGO_URI=mongodb://lifelink_app:<password>@127.0.0.1:27418/lifelink?authSource=lifelink
# Production: MongoDB Atlas
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifelink
# Behind a proxy / CDN (Render, Cloudflare, Nginx): read the client IP from X-Forwarded-For
TRUST_PROXY=1
# Web origins allowed for CORS / the PWA DigiLocker return (comma separated). The Android WebView origin is built in.
ALLOWED_ORIGINS=https://app.example.com

# --- First admin (only used when no admin exists yet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- SMS login codes: console | twilio_verify | twilio | msg91 ---
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=
# MSG91_AUTHKEY=
# MSG91_TEMPLATE_ID=
# DEVELOPMENT ONLY: return the OTP in the API response so you can sign in without SMS. NEVER in production.
# DEV_OTP=1

# --- Push notifications (Firebase service-account key) ---
# FCM_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# --- DigiLocker (leave DL_CLIENT_ID empty to run the built-in MOCK DigiLocker) ---
DL_CLIENT_ID=
DL_CLIENT_SECRET=
# Endpoint defaults follow DigiLocker's OAuth2 convention. Check them against the API spec you receive on onboarding:
# DL_BASE=https://api.digitallocker.gov.in
# DL_AUTHORIZE_URL=
# DL_TOKEN_URL=
# DL_USER_URL=
# DL_ISSUED_URL=
# DL_FILE_URL=
# DL_EAADHAAR_URL=
# Also store the approved identity PDFs (never Aadhaar) for later manual verification
# DL_FETCH_FILES=1
# Android deep link (matches AndroidManifest.xml)
APP_RETURN_URL=savrolifelink://digilocker/done

# --- DigiLocker via an aggregator / licensed provider (Gridlines, Setu, Cashfree, Digio ...) ---
# DL_PROVIDER=aggregator            # mock | oauth | aggregator (auto: oauth if DL_CLIENT_ID, aggregator if AGG_API_KEY, else mock)
# AGG_API_KEY=
# AGG_BASE=https://api.gridlines.io
# AGG_INIT_PATH=/digilocker/init
# AGG_ISSUED_PATH=/digilocker/issued-files   # confirm with: node tools/dl-check.js result <transaction_id>
# AGG_PROFILE_PATH=/digilocker/eaadhaar
# AGG_FILE_PATH=/digilocker/issued-file
# AGG_SIGNUP=PINLESS                         # PIN | PINLESS
# AGG_CONSENT_DAYS=30
# Response field overrides, "a.b|c.d" = first present: AGG_URL_PATH, AGG_TX_PATH, AGG_ITEMS_PATH
# DL_PURPOSE=Blood donor identity verification
# Direct DigiLocker (oauth) optional authorize parameters from the official Requester API spec:
# DL_PURPOSE_CODE=verification     # kyc | verification | compliance | availing_services | educational
# DL_CONSENT_DAYS=30
# DL_REQ_DOCTYPE=ADHAR,DRVLC,PANCR # only document types approved for your client id

# --- DigiLocker via Setu (documented API; recommended starting point) ---
# DL_PROVIDER=setu
# SETU_CLIENT_ID=
# SETU_CLIENT_SECRET=
# SETU_PRODUCT_INSTANCE_ID=
# SETU_ENV=sandbox                  # sandbox | production   (or set SETU_BASE yourself)

# --- OTP via Twilio ---
# Recommended: Twilio Verify (Twilio generates + checks the code)
# SMS_PROVIDER=twilio_verify
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=VA...
# Alternative: plain Twilio SMS (we generate the code)
# SMS_PROVIDER=twilio
# TWILIO_FROM=+1...                 # or TWILIO_MESSAGING_SERVICE_SID=MG...
# India needs DLT registration done with Twilio. Anything extra their India setup asks for goes here (JSON):
# TWILIO_EXTRA_PARAMS={}
