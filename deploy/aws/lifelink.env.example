# Copy to /etc/lifelink.env on the server (sudo nano /etc/lifelink.env). One KEY=value per line, no quotes, no spaces around "=".
PORT=8787
NODE_ENV=production
TRUST_PROXY=1
PUBLIC_BASE_URL=https://api.example.com
MONGO_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPPORT_EMAIL=
SMS_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
DL_PROVIDER=setu
SETU_ENV=sandbox
SETU_PRODUCT_INSTANCE_ID=
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
MAPBOX_TOKEN=
